# Variables de entorno del proyecto (copiar a .env y completar).
# El archivo .env NO se versiona. No escribir secretos reales aquí.

# ── Django ────────────────────────────────────────────
# Detalle de cada variable: specs/002-seguridad-acceso-configuracion/
# contracts/variables-entorno.md. Booleanos: true, false, 1, 0, sí, si, no.
# Una variable vacía equivale a no definida.

# Obligatoria. Clave propia de cada entorno (no subir; .env está en
# .gitignore). La clave del historial de git se da por comprometida.
# Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Al cambiarla se cierran las sesiones abiertas y dejan de valer los enlaces
# pendientes de activación y de restablecimiento de contraseña.
SECRET_KEY=

# Depuración. Por defecto, desactivada. En desarrollo local: true.
DEBUG=true

# Hosts permitidos, separados por comas. Obligatoria si DEBUG no está
# activo; con DEBUG activo y vacía, se admiten localhost y 127.0.0.1.
# Para acceder por la IP local desde otro equipo, agréguela aquí.
ALLOWED_HOSTS=

# Orígenes de confianza para formularios, con esquema (http:// o https://),
# separados por comas. Detrás de un proxy HTTPS, incluya https://<host> por
# cada host de ALLOWED_HOSTS que reciba formularios.
CSRF_TRUSTED_ORIGINS=

# ── Cookies y transporte seguro ───────────────────────
# Cookies solo por HTTPS (por defecto, true). Para acceder por HTTP desde
# otro equipo de la red local (p. ej., por la IP), use false en ese .env;
# en producción, déjelas en true.
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=

# Transporte seguro de producción (por defecto, desactivado).
# Si SECURE_SSL_REDIRECT=true detrás de un proxy que termina TLS, defina
# SECURE_PROXY_SSL_HEADER; si no, cada solicitud se redirige indefinidamente.
SECURE_SSL_REDIRECT=
# Segundos de la política HSTS (entero ≥ 0; p. ej., 31536000 = un año).
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
# Formato CABECERA,valor; p. ej., HTTP_X_FORWARDED_PROTO,https
SECURE_PROXY_SSL_HEADER=

# Ejemplo de producción detrás de un proxy HTTPS (dominio ilustrativo):
#   DEBUG=false
#   ALLOWED_HOSTS=erp.ejemplo.pe
#   CSRF_TRUSTED_ORIGINS=https://erp.ejemplo.pe
#   SECURE_SSL_REDIRECT=true
#   SECURE_HSTS_SECONDS=31536000
#   SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# ── Base de datos ─────────────────────────────────────────────
# 'sqlite' (solo desarrollo local) o 'postgresql' (producción y
# validación previa al despliegue; constitución §Base de datos).
DB_ENGINE=sqlite

# Obligatorias si DB_ENGINE=postgresql:
DB_NAME=
DB_USER=
DB_PASSWORD=

# Opcionales (valores por defecto: localhost y 5432):
DB_HOST=localhost
DB_PORT=5432

# Opcional: nombre de la base temporal de `manage.py test`
# (por defecto Django usa "test_" + DB_NAME).
DB_TEST_NAME=

# ── Correo ────────────────────────────────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
