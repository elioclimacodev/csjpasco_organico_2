# Variables de entorno del proyecto (copiar a .env y completar).
# El archivo .env NO se versiona. No escribir secretos reales aquí.

# ── Base de datos ─────────────────────────────────────────────
# 'sqlite' (solo desarrollo local) o 'postgresql' (producción y
# validación previa al despliegue; constitución §Base de datos).
DB_ENGINE=sqlite

# Obligatorias si DB_ENGINE=postgresql:
DB_NAME=
DB_USER=
DB_PASSWORD=

# Opcionales (valores por defecto: localhost y 5432):
DB_HOST=localhost
DB_PORT=5432

# Opcional: nombre de la base temporal de `manage.py test`
# (por defecto Django usa "test_" + DB_NAME).
DB_TEST_NAME=

# ── Correo ────────────────────────────────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
